import joblib
import numpy as np
import pandas as pd

# 1. Load the saved pipeline artifact from disk
model_pipeline = joblib.load("churn_pipeline.pkl")
print("Model pipeline loaded successfully from disk.")

# 2. Define a new sample customer dictionary
new_customer = {
    "SeniorCitizen": 0,
    "Partner": 1,
    "Dependents": 0,
    "tenure": 12,
    "PhoneService": 1,
    "MultipleLines": 0,
    "InternetService": "DSL",
    "OnlineSecurity": 1,
    "OnlineBackup": 0,
    "DeviceProtection": 0,
    "TechSupport": 0,
    "StreamingTV": 0,
    "StreamingMovies": 0,
    "Contract": "Month-to-month",
    "PaperlessBilling": 1,
    "PaymentMethod": "Electronic check",
    "MonthlyCharges": 45.50,
    "TotalCharges": 546.00,
    "TotalServicesUsed": 2,
}


# 3. Prediction function using the loaded artifact
def predict_churn(customer_dict):
  # Convert dictionary to single-row DataFrame
  df_input = pd.DataFrame([customer_dict])

  # Ensure TotalCharges is numeric
  df_input["TotalCharges"] = pd.to_numeric(
      df_input["TotalCharges"], errors="coerce"
  )

  # Predict probability of churning (class 1)
  churn_probability = model_pipeline.predict_proba(df_input)[0][1]
  churn_prediction = model_pipeline.predict(df_input)[0]

  return {
      "Churn_Probability": round(float(churn_probability), 4),
      "Predicted_Class": int(churn_prediction),
  }


# 4. Test the standalone prediction script
result = predict_churn(new_customer)
print("\n--- Prediction Results for New Customer ---")
print(f"Churn Probability: {result['Churn_Probability'] * 100:.2f}%")
print(
    "Prediction Status:",
    "High Risk (Likely to Churn)"
    if result["Predicted_Class"] == 1
    else "Low Risk (Not Churning)",
)

